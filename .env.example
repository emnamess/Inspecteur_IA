# Copiez ce fichier en `.env` (jamais commité) et remplissez vos valeurs.

# Clé API Anthropic : https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modèle utilisé par les agents (par défaut : claude-opus-5-5).
# claude-haiku-5-5 coûte beaucoup moins cher et suffit souvent pour les suspects.
LLM_MODEL=claude-opus-5-5
