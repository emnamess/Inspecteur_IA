# Copiez ce fichier en `.env` (jamais commité) et remplissez vos valeurs.

# Fournisseur du LLM : "gemini" (gratuit, par défaut) ou "anthropic" (Claude, payant).
LLM_PROVIDER=gemini

# Clé Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clé Anthropic (seulement si LLM_PROVIDER=anthropic) : https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modèle (optionnel). Par défaut : gemini-3.8-flash, ou claude-opus-5-5 avec Anthropic.
# LLM_MODEL=gemini-3.8-flash
# Modèles de secours si le principal est surchargé ou a épuisé son quota du jour :
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
